# Manufaction front door. The ONLY service published to the internet (ports 80/443).
#
#  /api/v1/health        public (for uptime monitors)
#  /api/*  + Bearer      machine-to-machine clients (ERP, MES, edge); Node-RED validates the token
#  /api/*  (browser)     basic auth, then Caddy swaps in the API token before proxying
#  /                     plant dashboard (static), basic auth
#
# The Node-RED editor is never proxied. Reach it with an SSH tunnel (see README).

{
	email {$MF_ACME_EMAIL}
}

{$MF_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/v1/health {
		reverse_proxy nodered:1880
	}

	handle /api/* {
		@bearer header_regexp Authorization ^Bearer\s.+$
		handle @bearer {
			reverse_proxy nodered:1880
		}
		handle {
			basic_auth {
				{$MF_BASIC_USER} {$MF_BASIC_HASH}
			}
			reverse_proxy nodered:1880 {
				header_up Authorization "Bearer {$MF_API_TOKEN}"
			}
		}
	}

	handle {
		basic_auth {
			{$MF_BASIC_USER} {$MF_BASIC_HASH}
		}
		root * /srv
		file_server
	}
}
