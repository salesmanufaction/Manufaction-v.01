# Manufaction front door. The ONLY service published to the internet (ports 80/443).
#
#  /api/v1/health        public (for uptime monitors)
#  /api/*  + Bearer      machine-to-machine clients (ERP, MES, edge); the CORE flows validate the token
#  /api/*  (browser)     basic auth, then Caddy swaps in the API token before proxying
#  /dashboard*           the plant dashboard (STUDIO), basic auth ("viewer" login)
#  /studio*              the STUDIO editor, protected by its own Node-RED login (customer admin / owner)
#  /                     redirects to the dashboard
#
# The CORE editor is never proxied. Reach it with an SSH tunnel (see README).

{
	email {$MF_ACME_EMAIL}
}

{$MF_SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		-Server
	}

	handle /api/v1/health {
		reverse_proxy core:1880
	}

	handle /api/* {
		@bearer header_regexp Authorization ^Bearer\s.+$
		handle @bearer {
			reverse_proxy core:1880
		}
		handle {
			basic_auth {
				{$MF_BASIC_USER} {$MF_BASIC_HASH}
			}
			reverse_proxy core:1880 {
				header_up Authorization "Bearer {$MF_API_TOKEN}"
			}
		}
	}

	handle /dashboard* {
		basic_auth {
			{$MF_BASIC_USER} {$MF_BASIC_HASH}
		}
		reverse_proxy studio:1880
	}

	handle /studio* {
		reverse_proxy studio:1880
	}

	handle {
		# "route" keeps the order as written: ask for the login first, then redirect.
		route {
			basic_auth {
				{$MF_BASIC_USER} {$MF_BASIC_HASH}
			}
			redir * /dashboard/overview 302
		}
	}
}
