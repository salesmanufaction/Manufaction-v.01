# Manufaction v2 environment. Copy to .env (scripts/setup.sh does this and fills in secrets).
# Never commit .env.

# --- public endpoint -------------------------------------------------------
# "localhost" for a laptop (self-signed cert), or your DNS name on a VM, e.g. demo.manufaction.com
MF_SITE_ADDRESS=localhost
MF_ACME_EMAIL=you@example.com
TZ=America/New_York

# --- dashboard login (Caddy basic auth) -----------------------------------
MF_BASIC_USER=admin
# bcrypt hash. Keep the SINGLE quotes — the hash contains "$".
# Generate: docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'your-password'
MF_BASIC_HASH='CHANGE_ME'

# --- API token for machine-to-machine clients (ERP/MES/edge) --------------
# At least 24 characters. Generate: openssl rand -hex 24
MF_API_TOKEN=CHANGE_ME

# --- Node-RED editor logins (bcrypt hashes, same generator as above) -------
# OWNER: opens the CORE editor (SSH tunnel to 127.0.0.1:1880) and can also open /studio.
CORE_ADMIN_USER=owner
CORE_ADMIN_HASH='CHANGE_ME'
# CUSTOMER ADMIN: opens the STUDIO editor at https://<site>/studio. Cannot reach CORE.
STUDIO_ADMIN_USER=customer
STUDIO_ADMIN_HASH='CHANGE_ME'

# --- branding (shown in both editors) ---------------------------------------
MF_BRAND_NAME=Manufaction

# --- internal service passwords --------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
# Password of the restricted database user the STUDIO uses (mf_studio). Set before the FIRST start.
STUDIO_DB_PASSWORD=CHANGE_ME
MQTT_NODERED_PASSWORD=CHANGE_ME
MQTT_EDGE_PASSWORD=CHANGE_ME

# --- behaviour -------------------------------------------------------------
MF_TELEMETRY_KEEP_DAYS=7
DEMO_ERP_ENABLED=true

# Alert delivery (optional). Leave the URL empty to keep notifications on the dashboard only.
# The URL is a secret (Slack/Teams URLs contain a token): keep it here, never in flows or Git.
#   MF_NOTIFY_FORMAT: json (default, full event for Zapier/Make/your endpoint) | slack (also Mattermost)
#                     | discord | text (plain body; for ntfy.sh phone push)
# Then:  docker compose up -d core     and test with  ./scripts/notify_test.sh
MF_NOTIFY_WEBHOOK_URL=
MF_NOTIFY_FORMAT=json
MF_NOTIFY_BEARER_TOKEN=
# Simulator: 1.0 = real time. 5 = five times faster (good for live demos).
SIM_SPEED=1.0
SIM_FAULT_RATE=0.02
SIM_SCRAP_RATE=0.03

# Demo mode (for recording): scheduled faults instead of random ones. Turn on with
#   SIM_DEMO_MODE=true   then   docker compose up -d simulator
SIM_DEMO_MODE=false
SIM_DEMO_FAULT_EVERY=75
SIM_DEMO_FAULT_SECONDS=30
